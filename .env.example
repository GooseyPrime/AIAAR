# Copy this file to .env and replace placeholder values before running live setup.
# Do not commit a populated .env file.

# eBay
EBAY_CLIENT_ID=YOUR_EBAY_CLIENT_ID
EBAY_CLIENT_SECRET=YOUR_EBAY_CLIENT_SECRET
# Optional: set EBAY_AUTH_TOKEN if you already have a valid token.

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Airtable
AIRTABLE_API_KEY=YOUR_AIRTABLE_API_KEY
AIRTABLE_BASE_ID=YOUR_AIRTABLE_BASE_ID
# Optional: override if your production base uses a different table for read probes.
AIRTABLE_HEALTHCHECK_TABLE="Target Items"

# Make.com
# Optional: override if you use a custom Make.com webhook/API hostname.
MAKE_WEBHOOK_BASE_URL=https://hook.make.com

# PayPal
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET

# ShipStation
SHIPSTATION_API_KEY=YOUR_SHIPSTATION_API_KEY
SHIPSTATION_API_SECRET=YOUR_SHIPSTATION_API_SECRET

# Email
EMAIL_PASSWORD=YOUR_EMAIL_PASSWORD
